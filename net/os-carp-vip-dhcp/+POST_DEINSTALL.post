# os-carp-vip-dhcp: remove generated files that pkg does not track, so an
# uninstall leaves no trace. Runs AFTER the packaged files are deleted. The
# rendered config, heartbeats and follow-state are all recreated on a reinstall.
# Per-keeper logs are kept for post-mortem (remove them by hand). The script
# directory + its __pycache__ are handled in +PRE_DEINSTALL so pkg removes the
# empty directory itself.
#
# The source-MAC rewrite (option E): +PRE_DEINSTALL's rc.d stop already removes every
# node of ours; this is the backstop, after the plugin's scripts (and its CARP hook)
# are gone. The same ownership as vmac.sh, from netgraph alone: every vmac_* patch
# node, and on the upper or lower hook of every ether node with a hook in use (the
# list says how many) a patch node under our name or
# an unnamed one with our build's signature ("in" on upper, "out" on lower). By the
# netgraph ID a read saw, never a hook path; read back up to three times. A read that
# fails (other than "no such node") or has no header is unreadable, never taken for
# clean: it is retried, then warned about on stderr and in the system log. Inline,
# because the plugin's scripts are already gone; ngctl is base system. Nothing runs
# without ng_patch.
if /sbin/kldstat -q -m ng_patch 2>/dev/null; then
    try=0
    while :; do
        ids='' unread='' ethers=''
        if out=$(/usr/sbin/ngctl list 2>&1) && printf '%s\n' "${out}" | grep -q 'Name:'; then
            ids=$(printf '%s\n' "${out}" | awk '$1 == "Name:" && $4 == "patch" && $2 ~ /^vmac_/ { print $6 }')
            ethers=$(printf '%s\n' "${out}" | awk '$1 == "Name:" && $4 == "ether" && $NF + 0 > 0 { print $2 }')
        else
            unread='the node list'
        fi
        for e in ${ethers}; do
            if out=$(/usr/sbin/ngctl show "${e}:" 2>&1); then
                if printf '%s\n' "${out}" | grep -q 'Name:'; then
                    ids="${ids} $(printf '%s\n' "${out}" | awk -v n="vmac_${e}" '
                        ($1 == "upper" || $1 == "lower") && $3 == "patch" && ($2 == n ||
                            ($2 == "<unnamed>" && (($1 == "upper" && $5 == "in") || ($1 == "lower" && $5 == "out")))) {
                            print $4
                        }')"
                else
                    unread="${unread} ${e}:"
                fi
            else
                case "${out}" in *"No such file or directory"*) ;; *) unread="${unread} ${e}:" ;; esac
            fi
        done
        ids=$(printf '%s\n' "${ids}" | tr ' ' '\n' | grep . | sort -u)
        [ -z "${ids}" ] && [ -z "${unread}" ] && break
        try=$((try + 1))
        if [ "${try}" -gt 3 ]; then
            ids=$(printf '%s' "${ids}" | tr '\n' ' ')
            unread="${unread# }"
            msg="could not remove the source-MAC rewrite (netgraph node ID(s): ${ids:-none}; unreadable: ${unread:-none}): it may still rewrite the source MAC; check with ngctl list and remove it by hand with: ngctl shutdown '[<id>]:'"
            echo "carpvipdhcp: ${msg}" >&2
            logger -t carpvipdhcp "${msg}" 2>/dev/null || :
            break
        fi
        for id in ${ids}; do
            /usr/sbin/ngctl shutdown "[${id}]:" >/dev/null 2>&1
        done
        [ "${try}" -gt 1 ] && sleep 1
    done
fi
rm -rf /usr/local/etc/carpvipdhcp
rm -f /var/run/carpvipdhcp-*.hb /var/run/carpvipdhcp-follow-* \
      /var/run/carpvipdhcp-follow_update.lock /var/run/carpvipdhcp-vmac.*
