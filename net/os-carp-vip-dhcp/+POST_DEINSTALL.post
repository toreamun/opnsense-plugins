# os-carp-vip-dhcp: remove generated files that pkg does not track, so an
# uninstall leaves no trace. Runs AFTER the packaged files are deleted. The
# rendered config, heartbeats and follow-state are all recreated on a reinstall.
# Per-keeper logs are kept for post-mortem (remove them by hand). The script
# directory + its __pycache__ are handled in +PRE_DEINSTALL so pkg removes the
# empty directory itself.
#
# The source-MAC rewrite (option E): +PRE_DEINSTALL's rc.d stop keeps it on a master
# (an upgrade must not flap it), so on removal sweep every node of ours here (D9),
# before keeper.conf goes: each vmac_* patch node, and a patch node that is ours or
# unnamed on a keeper's interface hooks (an interrupted build's). By the netgraph ID a
# read saw, never a hook path; read back up to three times; say so when something is
# left. A read that fails (other than "no such node") or has no header is unreadable,
# never taken for clean: it is retried, then warned about. Inline, because the
# plugin's scripts are already gone; ngctl is base system. Nothing runs without
# ng_patch.
if /sbin/kldstat -q -m ng_patch 2>/dev/null; then
    # keeper.conf fields are unordered: take iface= wherever it is in a record.
    ethers=$(awk -F'|' '!/^#/ { for (i = 1; i <= NF; i++) if ($i ~ /^iface=./) print substr($i, 7) }' \
                 /usr/local/etc/carpvipdhcp/keeper.conf 2>/dev/null | tr '.' '_' | sort -u)
    try=0
    while :; do
        ids='' unread=''
        if out=$(/usr/sbin/ngctl list 2>&1) && printf '%s\n' "${out}" | grep -q 'Name:'; then
            ids=$(printf '%s\n' "${out}" | awk '$1 == "Name:" && $4 == "patch" && $2 ~ /^vmac_/ { print $6 }')
        else
            unread='the node list'
        fi
        for e in ${ethers}; do
            if out=$(/usr/sbin/ngctl show "${e}:" 2>&1); then
                if printf '%s\n' "${out}" | grep -q 'Name:'; then
                    ids="${ids} $(printf '%s\n' "${out}" | awk -v n="vmac_${e}" \
                        '($1 == "upper" || $1 == "lower") && $3 == "patch" && ($2 == "<unnamed>" || $2 == n) { print $4 }')"
                else
                    unread="${unread} ${e}:"
                fi
            else
                case "${out}" in *"No such file or directory"*) ;; *) unread="${unread} ${e}:" ;; esac
            fi
        done
        ids=$(printf '%s\n' "${ids}" | tr ' ' '\n' | grep . | sort -u)
        [ -z "${ids}" ] && [ -z "${unread}" ] && break
        try=$((try + 1))
        if [ "${try}" -gt 3 ]; then
            ids=$(printf '%s' "${ids}" | tr '\n' ' ')
            unread="${unread# }"
            echo "carpvipdhcp: could not remove the source-MAC rewrite (netgraph node ID(s): ${ids:-none}; unreadable: ${unread:-none}): it may still rewrite the source MAC; check with ngctl list and remove it by hand with: ngctl shutdown '[<id>]:'" >&2
            break
        fi
        for id in ${ids}; do
            /usr/sbin/ngctl shutdown "[${id}]:" >/dev/null 2>&1
        done
        [ "${try}" -gt 1 ] && sleep 1
    done
fi
rm -rf /usr/local/etc/carpvipdhcp
rm -f /var/run/carpvipdhcp-*.hb /var/run/carpvipdhcp-follow-* \
      /var/run/carpvipdhcp-follow_update.lock
