# os-carp-vip-dhcp: clean (re)start after install/upgrade.
# The keeper daemons are supervised by daemon(8) and are NOT stopped by pkg, so
# restart here to sweep any stray daemons left by a previous version and run the
# current code. On a fresh install there is no keeper config yet, so this is a
# no-op ("no config").
#
# Re-render keeper.conf BEFORE the restart. pkg only drops the new files; it does
# not re-run the template, so on an upgrade the on-disk keeper.conf is still in
# the format the previous version wrote. This version's reader dispatches by key
# name, so an older positional file matches nothing -- the restart would stop
# every keeper and start none. The template regenerates the file from config.xml
# in the current format first. configd may be down in some install contexts (e.g.
# firstboot, where a full config apply renders it anyway), so tolerate a failure.
if [ -x /usr/local/etc/rc.d/carpvipdhcp ]; then
    /usr/local/sbin/configctl template reload OPNsense/CarpVipDhcp || true
    /usr/local/etc/rc.d/carpvipdhcp restart || true
fi
