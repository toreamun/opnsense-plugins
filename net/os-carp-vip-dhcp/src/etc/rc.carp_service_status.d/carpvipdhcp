#!/bin/sh

# CARP service-status hook for the CARP-VIP DHCP lease keepers.
#
# Exit 0  = all gated keepers hold the correct lease -> node eligible.
# Exit !0 = at least one gated keeper is NOT holding its lease   -> node demoted,
#           so the CARP VIP(s) move to the peer that DOES hold them.
#
# Only keepers with demote=1 influence CARP. If none are set the check always
# passes. Keep this test lightweight (it may run often). keeper.conf is one line
# per keeper, pipe-separated KEY=VALUE fields in no fixed order; we dispatch by
# key name and use only request= and demote= here.

CONF="/usr/local/etc/carpvipdhcp/keeper.conf"
RUN_DIR="/var/run"
# The daemon refreshes the heartbeat every ~30s while holding a lease; the
# largest legitimate gap is a failed-acquire backoff (~300s). 3600s is therefore
# a deliberately generous ceiling: demotion is drastic, so we only act on a
# truly stalled keeper, never a mid-cycle one. (The health *banner* uses a
# tighter 600s ceiling -- a notice is cheap, so it can be more responsive.)
MAX_AGE=3600
[ -f "${CONF}" ] || exit 0

# Shared keeper.conf line parser, also sourced by the rc.d service, so the two
# readers cannot drift (and it is unit-tested against keeperconf.py).
. /usr/local/opnsense/scripts/OPNsense/CarpVipDhcp/keeperconf.sh

_id()
{
    printf '%s' "$1" | tr -c 'A-Za-z0-9' '_'
}

now=$(date +%s)
# request/demote below are assigned by the sourced keeperconf.sh parser; the
# linter cannot follow its absolute install path, so scope-disable the
# "unassigned" warning to this loop only.
# shellcheck disable=SC2154
while IFS= read -r line || [ -n "${line}" ]; do
    case "${line}" in ''|\#*) continue ;; esac
    carpvipdhcp_parse_line "${line}"
    [ -n "${request}" ] || continue
    [ "${demote}" = "1" ] || continue
    hb="${RUN_DIR}/carpvipdhcp-$(_id "${request}").hb"
    [ -f "${hb}" ] || exit 1
    mtime=$(stat -f %m "${hb}" 2>/dev/null || echo 0)
    age=$(( now - mtime ))
    [ "${age}" -le "${MAX_AGE}" ] || exit 1
    content=$(cat "${hb}" 2>/dev/null)
    # A lease MISMATCH (ISP handed a different IP than the reserved VIP) is a fault
    # on either role, so judge it before the demote logic (as the status page does).
    # Its heartbeat carries no master= token, and the fail-stop is wanted on both.
    case "${content}" in *MISMATCH*) exit 1 ;; esac
    # A 1.14+ daemon owns the demote timing (the acquire grace) and publishes
    # demote_ok: the hook just obeys it. demote_ok=1 means this node is the CARP
    # master AND has been unable to hold the requested lease past the grace, so a
    # passive backup and a just-promoted master (still inside the grace) never set it.
    case "${content}" in
        *" demote_ok=1"*) exit 1 ;;      # keeper says demote (fail-stop)
        *" demote_ok=0"*) continue ;;    # keeper says eligible
    esac
    # No demote_ok token: a pre-1.14 daemon may still be running during an upgrade (a
    # failed keeper.conf render, or before the keeper restarts). Fall back to the old
    # role check so enforce-mode fail-stop is not silently disabled for a lease-less
    # old master until the daemon restarts on 1.14 (which always emits demote_ok, so
    # this fallback never runs for it). It keeps the old daemon's own behaviour,
    # including its known just-promoted-master window, for that transient window only.
    case "${content}" in
        *" master=1"*) : ;;              # old daemon, master: judge the lease
        *) continue ;;                   # old daemon, backup/unknown: not our concern
    esac
    case "${content}" in
        *"bound=${request} "*) : ;;
        *) exit 1 ;;                     # lease-less old master -> demote
    esac
done < "${CONF}"
exit 0
